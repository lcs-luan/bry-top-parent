<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>bry-top-parent</artifactId>
        <groupId>com.bry.parent</groupId>
        <version>2.0-jdk17-SNAPSHOT</version>
    </parent>

    <modelVersion>4.0.0</modelVersion>
    <version>2.0-jdk17-SNAPSHOT</version>
    <packaging>jar</packaging>
    <artifactId>bry-sentinel-starter</artifactId>

    <distributionManagement>
        <repository>
            <id>rdc-releases</id>
            <url>https://packages.aliyun.com/maven/repository/2045872-release-7Fg3Li/</url>
        </repository>
        <snapshotRepository>
            <id>rdc-snapshots</id>
            <url>https://packages.aliyun.com/maven/repository/2045872-snapshot-fqRLjA/</url>
        </snapshotRepository>
    </distributionManagement>

    <properties>
        <sentinel.version>1.8.6</sentinel.version>
        <sentinel.cloud.starter.version>2022.0.0.0</sentinel.cloud.starter.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.bry.parent</groupId>
            <artifactId>bry-common-utils</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!--SpringCloud ailibaba sentinel -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
            <version>${sentinel.cloud.starter.version}</version>
        </dependency>
        <dependency>
            <groupId>com.alibaba.csp</groupId>
            <artifactId>sentinel-datasource-nacos</artifactId>
            <version>${sentinel.version}</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>